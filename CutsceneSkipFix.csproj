<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\BONEWORKS\BONEWORKS</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" Private="false" HintPath="$(GameDir)\MelonLoader\MelonLoader.dll" />
    <Reference Include="0Harmony" Private="false" HintPath="$(GameDir)\MelonLoader\0Harmony.dll" />
    <Reference Include="UnhollowerBaseLib" Private="false" HintPath="$(GameDir)\MelonLoader\Managed\UnhollowerBaseLib.dll" />
    <Reference Include="Il2Cppmscorlib" Private="false" HintPath="$(GameDir)\MelonLoader\Managed\Il2Cppmscorlib.dll" />
    <Reference Include="Assembly-CSharp" Private="false" HintPath="$(GameDir)\MelonLoader\Managed\Assembly-CSharp.dll" />
    <Reference Include="SteamVR" Private="false" HintPath="$(GameDir)\MelonLoader\Managed\SteamVR.dll" />
    <Reference Include="UnityEngine.CoreModule" Private="false" HintPath="$(GameDir)\MelonLoader\Managed\UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.VideoModule" Private="false" HintPath="$(GameDir)\MelonLoader\Managed\UnityEngine.VideoModule.dll" />
  </ItemGroup>

  <Target Name="CopyToMods" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
  </Target>

</Project>
